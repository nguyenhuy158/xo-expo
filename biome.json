{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": ["@huyab/config/biome.json"],
  "files": {
    "includes": ["!**/.expo", "!**/ios", "!**/android", "!**/build"]
  },
  "linter": {
    "rules": {
      "complexity": {
        "useArrowFunction": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn"
      },
      "a11y": {
        "noSvgWithoutTitle": "warn"
      }
    }
  }
}
